; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TrucoProgC-"
run/main_scene="res://scenes/menu/MenuInicial.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

NetworkManager="*res://scripts/autoloads/NetworkManager.gd"
ServerRPCHandler="*res://scripts/server/ServerRPCHandler.gd"
ClientRPCHandler="*res://scripts/client/ClientRPCHandler.gd"
Global="*res://scripts/autoloads/Global.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://themes/GlobalTheme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
